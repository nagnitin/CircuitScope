# ============================================================
# CircuitScope .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environments ────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ── PyTorch / ML Model Weights ──────────────────────────────
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.pkl
*.pickle

# ── HuggingFace Cache ───────────────────────────────────────
.cache/
huggingface/

# ── Output artifacts (keep directory structure, ignore content)
outputs/**/*.png
outputs/**/*.svg
outputs/**/*.html
outputs/**/*.pdf
outputs/**/*.csv
outputs/**/*.json
outputs/**/*.log
outputs/**/*.txt
!outputs/**/.gitkeep

# ── Jupyter Notebooks ───────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── IDEs ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ─────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Miscellaneous ───────────────────────────────────────────
*.log
*.tmp
*.bak
.mypy_cache/
.dmypy.json
dmypy.json
